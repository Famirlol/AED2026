#include <iostream>

template <class T>
struct cNode {
    T VALOR;
    cNode* Next;
    cNode(T v) {
        VALOR = v;
        Next = nullptr;
    }
};

template <class T>
void add(cNode<T>*& head, T valor) {
    cNode<T>* nuevo = new cNode<T>(valor);
    if (!head) {
        head = nuevo;
        return;
    }
    cNode<T>* temp = head;
    while (temp->Next) {
        temp = temp->Next;
    }
    temp->Next = nuevo;
}

template <class T>
void Ejecuto(cNode<T>*& L1, cNode<T>* L2) {
    if (!L1) {
        L1 = L2;
        return;
    }
    if (!L2) return;

    cNode<T>* inicio;
    
    if (L1->VALOR <= L2->VALOR) {
        inicio = L1;
        L1 = L1->Next;
    } else {
        inicio = L2;
        L2 = L2->Next;
    }

    cNode<T>* actual = inicio;

    while (L1 && L2) {
        if (L1->VALOR <= L2->VALOR) {
            actual->Next = L1;
            L1 = L1->Next;
        } else {
            actual->Next = L2;
            L2 = L2->Next;
        }
        actual = actual->Next;
    }

    if (L1) actual->Next = L1;
    if (L2) actual->Next = L2;

    L1 = inicio;
}

template <class T>
void Print(cNode<T>* L) {
    while (L) {
        std::cout << L->VALOR << " -> ";
        L = L->Next;
    }
    std::cout << "NULL\n";
}

int main() {
    cNode<int>* L1 = nullptr;
    cNode<int>* L2 = nullptr;

    // Inserción manual en L1
    add(L1, 1);
    add(L1, 3);
    add(L1, 6);
    add(L1, 9);

    // Inserción manual en L2
    add(L2, 1);
    add(L2, 5);
    add(L2, 10);
    add(L2, 15);
    add(L2, 20);

    // Fusiona L1 y L2 reutilizando los nodos existentes por punteros
    Ejecuto(L1, L2);
    
    Print(L1);

    return 0;
}
