#include <iostream>
using namespace std;

template<class T, int N = 5>
struct Cola {
	int Longitud;
	T* arr;
	T* head = nullptr;
	T* tail = nullptr;

	Cola();
	~Cola();

	bool EstaLleno();
	bool EstaVacio();
	bool Push(T valor);
	bool Pop(T& valor);
	void Print();
};

template<class T, int N>
Cola<T, N>::Cola() {
	Longitud = N;
	arr = new T[Longitud];
	head = nullptr;
	tail = nullptr;
}

template<class T, int N>
Cola<T, N>::~Cola() {
	delete[] arr;
}

template<class T, int N>
bool Cola<T, N>::EstaVacio() {
	return (head == nullptr);
}

template<class T, int N>
bool Cola<T, N>::EstaLleno() {
	if (EstaVacio()) return false;
	return tail == head;
}

template<class T, int N>
bool Cola<T, N>::Push(T valor) {
	if (EstaLleno()) return false;

	if (EstaVacio()) {
		head = arr;
		tail = arr;
	}

	*tail = valor;

	if (tail == arr + Longitud - 1)
		tail = arr;
	else
		++tail;

	return true;
}

template<class T, int N>
bool Cola<T, N>::Pop(T& valor) {
	if (EstaVacio()) return false;

	valor = *head;

	if (head == arr + Longitud - 1)
		head = arr;
	else
		++head;

	if (head == tail) {
		head = nullptr;
		tail = nullptr;
	}

	return true;
}

template<class T, int N>
void Cola<T, N>::Print() {
	if (EstaVacio()) {
		cout << "Cola vacia" << endl;
		return;
	}

	cout << "Cola: [ ";
	T* actual = head;
	while (true) {
		cout << *actual << " ";
		T* siguiente = (actual == arr + Longitud - 1) ? arr : actual + 1;
		if (siguiente == tail) break;
		actual = siguiente;
	}
	cout << "]" << endl;

	cout << "Cabeza: " << *head << endl;
	cout << "Tail: " << *tail << endl;

}

int main() {
	Cola<int, 5> cola;
	int e;

	cola.Push(10);
	cola.Push(20);
	cola.Push(30);
	cola.Print();

	cola.Pop(e);
	cola.Print();

	cola.Push(40);
	cola.Push(50);
	cola.Push(60);
	cola.Print();

	return 0;
}
