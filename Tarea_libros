#include <iostream>
#include <string>
using namespace std;

struct Libro {
    string titulo{};
    string autor{};
    double precio{ 0.0 };
    int calificacion{ 0 };
};

template <class T>
struct Nodo {
    T valor;
    Nodo<T>* siguiente;

    Nodo(T v) : valor(v), siguiente(nullptr) {}
};

struct ComparadorLibro {
    int criterio;
    bool ascendente;

    ComparadorLibro(int c, bool a) : criterio(c), ascendente(a) {}

    bool operator()(const Libro& a, const Libro& b) {
        switch (criterio) {
        case 1: return ascendente ? a.titulo < b.titulo : a.titulo > b.titulo;
        case 2: return ascendente ? a.autor < b.autor : a.autor > b.autor;
        case 3: return ascendente ? a.precio < b.precio : a.precio > b.precio;
        case 4: return ascendente ? a.calificacion < b.calificacion : a.calificacion > b.calificacion;
        }
        return false;
    }
};

template <class T, class Comparador>
class ListaOrdenada {
public:
    ListaOrdenada(Comparador c) : cabeza(nullptr), comp(c) {}

    bool buscar(T x, Nodo<T>**& p) {
        for (p = &cabeza; *p && comp((*p)->valor, x); p = &((*p)->siguiente));

        return *p &&
            !comp(x, (*p)->valor) &&
            !comp((*p)->valor, x);
    }

    bool insertar(T x) {
        Nodo<T>** p;
        if (buscar(x, p)) return false;

        Nodo<T>* nuevo = new Nodo<T>(x);
        nuevo->siguiente = *p;
        *p = nuevo;

        return true;
    }

    void imprimir() {
        for (Nodo<T>* t = cabeza; t; t = t->siguiente) {
            cout << t->valor.titulo << " | "
                << t->valor.autor << " | "
                << t->valor.precio << " | "
                << t->valor.calificacion << endl;
        }
    }

    void buscarTitulo(const string& titulo) {
        for (Nodo<T>* t = cabeza; t; t = t->siguiente) {
            if (t->valor.titulo == titulo) {
                cout << t->valor.titulo << " | "
                    << t->valor.autor << " | "
                    << t->valor.precio << " | "
                    << t->valor.calificacion << endl;
            }
        }
    }

    void buscarAutor(const string& autor) {
        for (Nodo<T>* t = cabeza; t; t = t->siguiente) {
            if (t->valor.autor == autor) {
                cout << t->valor.titulo << " | "
                    << t->valor.autor << " | "
                    << t->valor.precio << " | "
                    << t->valor.calificacion << endl;
            }
        }
    }

private:
    Nodo<T>* cabeza;
    Comparador comp;
};


int main() {
    int criterio;
    int orden = 1;
    bool asc = true;

    cout << "\n1. Titulo\n2. Autor\n3. Precio\n4. Calificacion\n";
    cin >> criterio;

    if (criterio == 3 || criterio == 4) {
        cout << "Orden:\n1. Ascendente\n2. Descendente\n";
        cin >> orden;
        asc = (orden == 1);
    }

    ComparadorLibro comp(criterio, asc);
    ListaOrdenada<Libro, ComparadorLibro> lista(comp);

    lista.insertar({ "1984", "Orwell", 40, 5 });
    lista.insertar({ "ElQuijote", "Cervantes", 30, 4 });
    lista.insertar({ "CienAnosDeSoledad", "GarciaMarquez", 45, 5 });
    lista.insertar({ "LaMetamorfosis", "Kafka", 25, 5 });
    lista.insertar({ "ElPrincipito", "SaintExupery", 20, 4 });

    int op;
    do {
        cout << "\n1. Insertar";
        cout << "\n2. Mostrar todos";
        cout << "\n3. Buscar por titulo";
        cout << "\n4. Buscar por autor";
        cout << "\n0. Salir\n";

        cin >> op;

        if (op == 1) {
            Libro l;
            cin >> l.titulo >> l.autor >> l.precio >> l.calificacion;
            lista.insertar(l);
        }
        else if (op == 2) {
            lista.imprimir();
        }
        else if (op == 3) {
            string t;
            cin >> t;
            lista.buscarTitulo(t);
        }
        else if (op == 4) {
            string a;
            cin >> a;
            lista.buscarAutor(a);
        }

    } while (op != 0);

    return 0;
}
